// Prisma schema for Mobixi multi-tenant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  STORE_ADMIN
}

enum ProductType {
  PHYSICAL
  DIGITAL
  HYBRID
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum DeliveryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  MANUAL
  CASH
  TRANSFER
  CARD
  DIGITAL_WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model SuperAdmin {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  role        String   @default("SUPER_ADMIN")
  permissions Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  resetToken  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model Store {
  id            String            @id @default(uuid())
  name          String
  description   String?           @map("description")
  address       String?
  logo          String?
  phone         String?           @map("phone")
  email         String?           @map("email")
  website       String?           @map("website")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  storeAdmins   StoreAdminStore[]
  users         User[]
  products      Product[]
  subscriptions Subscription[]

  @@map("stores")
}

model StoreAdmin {
  id          String            @id @default(uuid())
  email       String            @unique
  password    String
  firstName   String            @map("first_name")
  lastName    String            @map("last_name")
  role        String            @default("STORE_ADMIN")
  permissions Json              @default("{}")
  isActive    Boolean           @default(true) @map("is_active")
  resetToken  String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  stores      StoreAdminStore[]

  @@map("store_admins")
}

model StoreAdminStore {
  id           String     @id @default(uuid())
  storeAdminId String     @map("store_admin_id")
  storeId      String     @map("store_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  storeAdmin   StoreAdmin @relation(fields: [storeAdminId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeAdminId, storeId])
  @@map("store_admin_stores")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  role          String         @default("USER")
  permissions   Json           @default("{}")
  isActive      Boolean        @default(true) @map("is_active")
  resetToken    String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  storeId       String         @map("store_id")
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  deliveries    Delivery[]
  payments      Payment[]

  @@map("users")
}

model Product {
  id               String         @id @default(uuid())
  storeId          String         @map("store_id")
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  price            Decimal        @db.Decimal(10, 2)
  type             ProductType    @default(PHYSICAL)
  category         String?
  image            String?
  isActive         Boolean        @default(true) @map("is_active")
  maxSubscriptions Int?           @map("max_subscriptions")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  subscriptions    Subscription[]
  deliveries       Delivery[]

  @@map("products")
}

model Subscription {
  id                String             @id @default(uuid())
  storeId           String             @map("store_id")
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status            SubscriptionStatus @default(ACTIVE)
  startDate         DateTime           @default(now()) @map("start_date")
  endDate           DateTime?          @map("end_date")
  nextDeliveryDate  DateTime?          @map("next_delivery_date")
  deliveryFrequency DeliveryFrequency  @default(MONTHLY) @map("delivery_frequency")
  totalDeliveries   Int                @default(0) @map("total_deliveries")
  deliveredCount    Int                @default(0) @map("delivered_count")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  userId            String             @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String             @map("product_id")
  product           Product            @relation(fields: [productId], references: [id])
  deliveries        Delivery[]
  payments          Payment[]

  @@map("subscriptions")
}

model Delivery {
  id             String         @id @default(uuid())
  status         DeliveryStatus @default(PENDING)
  scheduledDate  DateTime       @map("scheduled_date")
  deliveredDate  DateTime?      @map("delivered_date")
  trackingCode   String?        @map("tracking_code")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  subscriptionId String         @map("subscription_id")
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String         @map("product_id")
  product        Product        @relation(fields: [productId], references: [id])
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id])

  @@map("deliveries")
}

model Payment {
  id             String        @id @default(uuid())
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod @default(MANUAL)
  status         PaymentStatus @default(PENDING)
  reference      String?
  notes          String?
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}
